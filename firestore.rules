rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function membre() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['<EMAIL_1>', '<EMAIL_2>'];
    }
    match /{document=**} {
      allow read, write: if membre();
    }
  }
}
